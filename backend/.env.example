# PostgreSQL. Для Docker: postgresql://user:password@db:5432/realcpa
DATABASE_URL="postgresql://realcpa:realcpa@localhost:5432/realcpa?schema=public"

# API
PORT=3000
JWT_SECRET=your-secret-change-in-production

# Базовый URL API для трекинг-ссылок (например https://api.example.com)
# API_BASE_URL=http://localhost:3000

# Секрет для одноразового восстановления админа (POST /api/restore-admin). Задайте и вызовите эндпоинт один раз, затем можно удалить.
# RESTORE_ADMIN_SECRET=ваш-длинный-секрет

# --- Импорт внешних объявлений (Админка → Импорт объявлений) ---
# Redis нужен для суточного BullMQ job (docker-compose: redis://redis:6379)
REDIS_URL=redis://127.0.0.1:6379

# Секрет для внешнего webhook Apify/Crawlee: POST /api/integrations/listings/import
# Заголовок: x-listings-import-secret
LISTINGS_IMPORT_SECRET=замените-на-длинный-секрет

# true — поднять worker и cron раз в сутки
LISTINGS_IMPORT_ENABLED=true

# Cron (по умолчанию 03:00)
LISTINGS_IMPORT_CRON=0 3 * * *

# JSON-лента для суточного/ручного импорта (Apify dataset items URL и т.п.)
# LISTINGS_FEED_URL=https://api.apify.com/v2/datasets/DATASET_ID/items?token=...

LISTINGS_SOURCE=agroserver.ru
LISTINGS_DEFAULT_CATEGORY_SLUG=agrochemistry
LISTINGS_DEFAULT_STATUS=active
LISTINGS_DEFAULT_PAYOUT=300
LISTINGS_SUPPLIER_EMAIL=supplier@example.com

# Если webhook Apify шлёт только datasetId
# APIFY_TOKEN=
